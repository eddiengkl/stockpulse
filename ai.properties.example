# StockPulse - AI advisor configuration (EXAMPLE)
#
# Copy this file to  ai.properties  in the project root and fill in a key:
#
#     cp ai.properties.example ai.properties
#
# ai.properties is listed in .gitignore, so a real key is never committed.
# This example file is committed on purpose and must never hold a key.
#
# The key is read at startup, in this order:
#   1. ai.properties      (gemini.apiKey below)
#   2. the environment variable  GEMINI_API_KEY
#
# The placeholder below is treated as "not set". Copying this file and exporting
# GEMINI_API_KEY therefore uses the environment key, instead of sending the literal
# text PASTE-YOUR-KEY-HERE to Google and reporting that the key was rejected.
#
# If neither is set, StockPulse still runs: GET /api/advisor/briefing answers with a
# rule-based summary and labels it "source": "RULES". It is not AI output.
#
# A key is also never printed to the console, written to the data files, or returned
# by the API - the startup banner reports only where the key came from.

gemini.apiKey=PASTE-YOUR-KEY-HERE

# Optional. Defaults to gemini-3.8-flash if the line is absent.
#
# gemini-3.8-flash is a stable model that outputs text, which is all this feature
# uses. It replaces gemini-2.0-flash, which Google shut down on 1 June 2026:
#   https://ai.google.dev/gemini-api/docs/models/gemini-3.8-flash
#
# If this name is wrong or retired, the API reports the reason "ModelUnavailable"
# and still shows the rule-based summary. It does not claim the key was rejected.
gemini.model=gemini-3.8-flash
